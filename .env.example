# Copy to .env and fill in for real NIM calls. Never commit .env.
# Everything runs offline without a model: the Coder falls back to the
# checked-in reference invaders source as the codegen oracle.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=
NVIDIA_API_KEY=
# Optional: A2A_LLM_TIMEOUT=60.0

# Role-scoped bearer tokens (E-38/E-66). Required for the three-CLI demo;
# the service fails closed (401 on every non-card route) when unset.
A2A_TOKEN_DESIGNER=change-me-designer
A2A_TOKEN_CRITIC=change-me-critic

# Optional overrides
# A2A_CODER_DB=data/coder.db
# A2A_TRACE_PATH=logs/trace.jsonl
# A2A_DESIGNER_PROFILE=profiles/designer.json
# A2A_CODER_PROFILE=profiles/coder.json
